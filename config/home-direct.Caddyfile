{
	https_port 8443
	auto_https disable_redirects
}

91-159-12-133.sslip.io {
	@local_authorize {
		path /authorize
		remote_ip private_ranges
	}
	handle @local_authorize {
		reverse_proxy 127.0.0.1:3022
	}
	@authorize path /authorize
	respond @authorize "Owner authorization required" 403
	handle {
		reverse_proxy 127.0.0.1:3022
	}
}
