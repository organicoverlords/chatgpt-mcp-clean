[
  {
    "name": "kill_process",
    "description": "Terminate a process and its child process tree.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "process_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "process_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "caller_id": {
          "type": "string"
        },
        "serving_identity": {
          "type": "object",
          "properties": {
            "tool_contract_version": {
              "type": "string",
              "const": "process-tools.v4"
            },
            "backend_generation": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "tool_contract_version"
          ],
          "additionalProperties": false
        },
        "process_id": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "killed": {
          "type": "boolean"
        },
        "already_exited": {
          "type": "boolean",
          "const": true
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "kill_requested": {
          "type": "boolean",
          "const": true
        },
        "running": {
          "type": "boolean"
        },
        "kill_timed_out": {
          "type": "boolean",
          "const": true
        },
        "error": {
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "caller_id",
        "serving_identity",
        "process_id",
        "pid",
        "killed"
      ],
      "additionalProperties": false
    }
  },
