[
  {
    "name": "download_chatgpt_file",
    "description": "Save one exact ChatGPT file onto the MCP host without transcoding. Pass the ChatGPT file in file and an absolute destination_path; overwrite defaults to false. The server streams the temporary ChatGPT download URL directly to disk and returns byte count plus SHA-256.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "file": {
          "type": "object",
          "properties": {
            "download_url": {
              "type": "string",
              "minLength": 1
            },
            "file_id": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string"
            },
            "file_name": {
              "type": "string"
            }
          },
          "required": [
            "download_url",
            "file_id"
          ],
          "additionalProperties": false
        },
        "destination_path": {
          "type": "string",
          "minLength": 1
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "destination_path"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "const": "chatgpt_to_local"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "file_id": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "destination_path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "direction",
        "status",
        "file_id",
        "file_name",
        "mime_type",
        "destination_path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
